# Токен от @BotFather. Остальные значения ниже — дефолты приложения.
BOT_TOKEN=

# Владелец управляет всеми чатами; ID через запятую. Сначала напиши боту /start.
# Без владельцев новые чаты одобряются автоматически.
# OWNER_IDS=123456789
# Пустой allowlist разрешает все одобренные чаты. При миграции группы ID меняется.
# ALLOWED_CHATS=-1001234567890

# Капча: три этапа с указанным интервалом; вся серия — одна попытка.
# Эти дефолты можно переопределить для чата через меню.
CAPTCHA_STAGE_MINUTES=2
MAX_ATTEMPTS=3
# Задержка отправки после мгновенного мута; 3000 мс нужны для отрисовки клиента.
CAPTCHA_DELAY_MS=3000

# Статистика по дням МСК; час отправки сводки здесь задаётся в UTC (6 = 9 МСК).
NEWCOMER_DAYS=7
SILENT_ANNOUNCE_DAYS=30
DAILY_STATS_UTC_HOUR=6
# SILENT_ANNOUNCE_DAYS=0 отключает анонсы вернувшихся после молчания.

LOG_LEVEL=info
# В compose пути переопределены: /data/bot.db, /data/bot.log, /data/archive.
# Локально LOG_FILE пуст: только stdout. Файл нужен для команды /logs.
# DB_PATH=./bot.db
# LOG_FILE=./bot.log

# ИИ-антиспам включается для чата в меню; нужен хотя бы один ключ.
# Модели ниже — дефолты клиентов; доступность зависит от провайдера/аккаунта.
# GROQ_API_KEY=
# GROQ_MODEL=groq/compound-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GigaChat: authorization key (base64 от client_id:secret).
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# Неизвестный провайдер или дубликат в списке — ошибка запуска.
# AI_PROVIDER_ORDER=groq,gemini,gigachat

# Полный текстовый след сообщений/правок. По умолчанию ВЫКЛЮЧЕН.
# Включение не собирает старые сообщения; выключение не удаляет накопленные.
# MESSAGE_CAPTURE_ENABLED=0
# Пустой ARCHIVE_DIR = <каталог DB_PATH>/archive.
# ARCHIVE_DIR=./archive
# Горячее окно в SQLite; 0 архивирует каждый завершённый день.
# Архивы хранятся без автоудаления: это НЕ срок хранения данных.
# MESSAGE_ARCHIVE_HOT_DAYS=7

# Наблюдение за ответом на приветствие: снимок в БД и пробы через 1/5/15/60 мин.
# Независимо от MESSAGE_CAPTURE_ENABLED. 0 отключает и очищает наблюдения.
# REPLY_WATCH_ENABLED=1
# Пробы кратко копируют сообщение (включая медиа) в этот ПРИВАТНЫЙ чат/канал.
# Боту нужны права писать/удалять. Пусто = ЛС наименьшего ID из OWNER_IDS;
# явно заданный 0 недопустим. Отчёты получают владельцы в ЛС.
# REPLY_WATCH_CHAT_ID=-1001234567890
