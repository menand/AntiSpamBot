# Обязательно — токен бота от @BotFather
BOT_TOKEN=

# Опционально (показаны значения по умолчанию)
# Интервал между сообщениями серии капчи в минутах: капча → через N мин
# напоминание → ещё через N «последнее предупреждение» → ещё через N кик.
CAPTCHA_STAGE_MINUTES=2
MAX_ATTEMPTS=3

# Задержка перед отправкой капчи после входа (мс).
# Даёт клиенту только что вошедшего пользователя время полностью открыть
# чат — иначе его клиент иногда не отрисовывает капчу в уже открытой вьюхе.
# В окне задержки любые сообщения от этого юзера автоматически удаляются.
# 0 — сразу без задержки.
CAPTCHA_DELAY_MS=3000
LOG_LEVEL=info
NEWCOMER_DAYS=7

# Через сколько дней молчания бот поздравит вернувшегося с "ухты!".
# 0 — выключить эти анонсы.
SILENT_ANNOUNCE_DAYS=30

# Час в UTC, в который бот присылает ежедневную сводку в чаты, где владелец
# или админ включил её через меню /chats → чат → ⚙️ Настройки → 📊 Сводка.
# По умолчанию 6 UTC ≈ 9:00 МСК. Диапазон 0..23.
DAILY_STATS_UTC_HOUR=6

# Путь к SQLite-файлу.
# В Docker compose он переопределяется на /data/bot.db (volume bot-data).
# Локально по умолчанию — ./bot.db
# DB_PATH=./bot.db

# Путь к лог-файлу. Если задан — бот пишет JSON-логи и в stdout (для docker logs),
# и в этот файл с ротацией (10 МБ × 3 бэкапа, макс. 30 дней).
# Владельцы могут получить файл командой /logs в личке.
# В Docker compose выставляется автоматически в /data/bot.log.
# Локально по умолчанию — пусто (только stdout).
# LOG_FILE=./bot.log

# Опционально — белый список chat_id через запятую.
# Если задан, бот игнорирует новых участников в других чатах.
# Если пусто — работает во всех чатах, где его сделали админом.
# ALLOWED_CHATS=-1001234567890,-1009876543210

# Опционально — Telegram user_id владельцев бота через запятую.
# Владельцы:
#   • получают уведомления о старте/остановке бота в личку;
#   • видят и управляют всеми чатами бота в DM-меню (/chats);
#   • имеют доступ к /logs, /info, проверке ИИ-провайдеров и
#     🔔 спам-уведомлениям в ЛС.
# Чтобы узнать свой user_id: напиши боту /start в личку — он покажет ID.
# ВАЖНО: для получения уведомлений владелец должен был хоть раз написать
# боту (иначе Telegram не позволит боту инициировать переписку).
# OWNER_IDS=123456789

# Опционально — ключ Groq API для ИИ-антиспама (анализ сообщений новичков).
# Модель по умолчанию — groq/compound-mini, можно переопределить.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=groq/compound-mini

# Опционально — Gemini API (Google) как второй фолбек ИИ-антиспама: бесплатный
# тир AI Studio, OpenAI-совместимый эндпоинт. Может работать и единственным
# провайдером. Ключ — aistudio.google.com/apikey.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# (если переопределить на 2.5-модель вроде gemini-2.5-flash — её «мышление»
# может съедать лимит токенов, и ответ приходит пустым; reasoning_effort=none
# помогает не всегда (2.5-flash-lite пустовала и с ним). 3.x-модели
# reasoning_effort отвергают и работают без него)

# Опционально — GigaChat API (Сбер) как третий фолбек ИИ-антиспама: подхватывает,
# когда Groq и Gemini отдают ошибку (чаще всего минутный rate-limit). Может
# работать и единственным провайдером. Без всех трёх ключей фича недоступна
# (тумблер в настройках чата не включится).
# GIGACHAT_AUTH_KEY — authorization key из личного кабинета developers.sber.ru
# (base64 от client_id:secret). Scope по умолчанию GIGACHAT_API_PERS
# (персональный аккаунт), модель — GigaChat (Lite).
# GIGACHAT_AUTH_KEY=...
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat

# Опционально — порядок цепочки ИИ-провайдеров (комма-список из groq, gemini,
# gigachat). По умолчанию: groq,gemini,gigachat. Строгий парсинг: неизвестное
# имя или дубликат — ошибка запуска.
# AI_PROVIDER_ORDER=groq,gemini,gigachat

# Опционально — расширенный сбор статистики (инструмент msgtool).
#
# MESSAGE_CAPTURE_ENABLED — включает ли бот запись текстового следа всех
# сообщений обслуживаемых чатов в hot-таблицу messages. По умолчанию выключено
# (false); 1/true — включить. Записи идут в фоновую горутину (не на горячий
# путь модерации) и с 7 дней упаковываются в дневные zstd-архивы рядом с БД.
# Бэкфилла нет: след начинается с момента включения флага.
# MESSAGE_CAPTURE_ENABLED=1
#
# ARCHIVE_DIR — каталог дневных архивов. Пусто = <dir(DB_PATH)>/archive
# (в Docker это /data/archive). Создаётся при старте.
# ARCHIVE_DIR=/data/archive
#
# MESSAGE_ARCHIVE_HOT_DAYS — сколько дней текст держится «горячим» в SQLite,
# прежде чем архиватор упакует день в zstd и удалит hot-строки. Дефолт 7.
# Внимание: это окно быстрого доступа, а НЕ срок хранения — сами дневные
# архивы в ARCHIVE_DIR не удаляются никогда. Ждать авто-очистки не нужно и
# не нужно: чтобы освободить место, архивы чистятся руками на VDS
# (rm нужных дат). Удаление разрешено только владельцу — на то и ручной путь.
# MESSAGE_ARCHIVE_HOT_DAYS=7

# Отслеживание удаления/правки осмысленного ответа на «приветствие с
# ответом» (welcome_mode=reply). Бот раз в 1/5/15/60 минут копирует сообщение
# в служебный чат и сразу удаляет копию: успех = сообщение живо, «message to
# copy not found» = удалено. О правке приходит «было → стало», об удалении —
# карточка с автором и текстом; прожило 60 минут — молчание.
#
# REPLY_WATCH_ENABLED — включено по умолчанию (1); 0/false — выключить.
# REPLY_WATCH_CHAT_ID — служебный чат/канал для проб (бот должен иметь право
# писать и удалять). Пусто = ЛС низшего по id из OWNER_IDS. 0 недопустим.
# ВАЖНО: служебный чат должен быть приватным (бот + владелец). Копия сообщения
# юзера живёт там секунды, но видна всем участникам; публичный чат/канал даёт
# предупреждение в логах на старте. Отчёты уходят только OWNER_IDS в ЛС.
# Карточки о правках не чаще раза в 5 минут и максимум 3 на сообщение.
# REPLY_WATCH_ENABLED=1
# REPLY_WATCH_CHAT_ID=-1001234567890
